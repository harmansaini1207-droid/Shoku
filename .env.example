# SHOKU (職人リンク) — Environment Configuration
# Default configuration runs 100% offline with zero external services or API keys.

# LLM Provider Configuration
# Options: 'scripted' (offline deterministic default) | 'ollama' | 'openai-compat'
LLM_PROVIDER=scripted
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=swallow:8b

# Speech-to-Text (STT) Provider
# Options: 'scripted' (offline default) | 'whisper-server' (faster-whisper or whisper.cpp)
STT_PROVIDER=scripted
STT_BASE_URL=http://localhost:8000

# Embeddings Provider
# Options: 'hash' (offline 256-dim deterministic embedder) | 'ollama' (bge-m3 / multilingual)
EMBEDDINGS_PROVIDER=hash
EMBEDDINGS_MODEL=bge-m3
